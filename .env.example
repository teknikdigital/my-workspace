# ==============================================================================
# MY WORKSPACE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Supabase (Wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fase 2: Vault Encryption Key (Wajib untuk Vault)
# Generate 32-byte hex string: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=

# Fase 3: AI Assistant (Opsional, pilih salah satu atau keduanya)
AI_PROVIDER=openai # 'openai' atau 'claude'
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Fase 4: Structured Activity Receiver (Opsional)
# Secret key untuk webhook /api/activity (dikirim via Header: Authorization: Bearer <token>)
ACTIVITY_WEBHOOK_SECRET=

# Fase 5: WhatsApp Webhook & Meta Cloud API (Opsional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_PHONE= # Format e164 misal: 6281234567890
# Email login My Workspace milik pemilik nomor di atas (AI berjalan dengan hak akses akun ini)
WHATSAPP_OWNER_EMAIL=
# Opsional, default v25.0
WHATSAPP_GRAPH_VERSION=v25.0

# Fase 6: Telegram Bot (Opsional, lihat docs/TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
# Acak 16-256 karakter (huruf/angka/_/-), harus sama di Vercel & .env.local
TELEGRAM_WEBHOOK_SECRET=
# ID Telegram pemilik (angka). Kosongkan dulu: bot akan membalas ID Anda.
TELEGRAM_OWNER_ID=

# Email login My Workspace pemilik bot (WhatsApp & Telegram). Bila kosong dipakai WHATSAPP_OWNER_EMAIL.
MW_OWNER_EMAIL=
# Batas tunggu job Claude Code di antrian (jam, default 24, maks 72)
# CLAUDE_QUEUE_TTL_HOURS=24

# Vercel Cron Secret (Opsional untuk reminder cron job)
CRON_SECRET=

# Pembatas biaya AI (opsional)
AI_DAILY_BUDGET_IDR=5000
AI_USD_IDR=16500
