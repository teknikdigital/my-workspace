{
  "port": 4545,
  "allowedOrigins": [
    "http://localhost:3000",
    "http://127.0.0.1:3000",
    "https://digitalworkspace.vercel.app"
  ],
  "maxUploadMB": 200,
  "inboxName": "_Masuk",
  "claude": {
    "path": "C:\\Users\\julia\\.local\\bin\\claude.exe",
    "defaultModel": "sonnet",
    "timeoutMinutes": 30,
    "maxConcurrent": 2
  },
  "apps": [
    {
      "id": "myworkspace",
      "name": "My Workspace",
      "group": "Personal",
      "description": "Personal Work & Life OS (Next.js 14)",
      "url": "http://localhost:3000",
      "folder": "D:\\Project\\myworkspace",
      "embeddable": false,
      "autoStart": false,
      "processes": [
        {
          "name": "web",
          "cwd": "D:\\Project\\myworkspace",
          "command": "npm run dev -- -p 3000",
          "port": 3000
        }
      ],
      "actions": [
        {
          "id": "install",
          "label": "Install Dependencies",
          "cwd": "D:\\Project\\myworkspace",
          "command": "npm install"
        }
      ],
      "claude": {
        "mode": "edit",
        "project": "My Workspace"
      }
    },
    {
      "id": "rapiuang",
